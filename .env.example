# ============================================================
# آرامینا — متغیرهای محیطی docker-compose (ریشه‌ی پروژه)
# این فایل را به .env کپی کنید و مقادیر واقعی را وارد کنید.
# ⚠️ فایل .env هرگز نباید در گیت commit شود.
# ============================================================

# پایگاه داده
DB_USER=aramina
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=mental_health_db

# JWT — حتماً یک رشته‌ی تصادفی و بلند بگذارید (مثلاً خروجی: openssl rand -hex 32)
JWT_SIGN_KEY=CHANGE_ME_to_a_long_random_secret

# دامنه‌های مجاز CORS (آدرس عمومی فرانت‌اند شما)
# مثال: https://aramina.example.com
ALLOWED_ORIGINS=http://localhost:3000

# آدرس عمومی API که فرانت در زمان build استفاده می‌کند
# مثال: https://api.aramina.example.com/  (اسلش پایانی مهم است)
NEXT_PUBLIC_API_URL=http://localhost:8086/
