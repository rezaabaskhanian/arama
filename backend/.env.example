# ============================================================
# آرامینا — نمونه‌ی متغیرهای محیطی (12-Factor Config)
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید.
# اسرار واقعی هرگز نباید در گیت commit شوند.
# ============================================================

# محیط اجرا: development | production
ENV=development

# سطح لاگ: info | debug
LOG_LEVEL=info

# سرور HTTP
HTTP_PORT=8086

# دامنه‌های مجاز CORS (با کاما جدا کنید) — روی VPS دامنه‌ی فرانت را اینجا بگذارید
# مثال production: https://aramina.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# مسیر فایل‌های migration (داخل Docker معمولاً ./migrations)
MIGRATIONS_DIR=../internal/repository/postgres/migrations

# پایگاه داده PostgreSQL
DB_HOST=localhost
DB_PORT=5431
DB_USER=reza_abasi
DB_PASSWORD=change_me
DB_NAME=mental_health_db

# JWT (در production حتماً یک کلید تصادفی و امن قرار دهید)
JWT_SIGN_KEY=change_me_to_a_long_random_secret
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h
